define(['jquery','Magento_Customer/js/customer-data'],function($,customerData){"use strict";let deferredGa={};let ajax=new Promise((resolve,reject)=>{$.ajaxSetup({dataFilter:function(data){if(this.url.indexOf('b2b_price_page_cache/block/render')!==-1){JSON.parse(data,(key,value)=>{parceResponse(value)})
resolve(data)}
return data}});})
let parceResponse=item=>{if(typeof item==="string"){let parser=new DOMParser();let elem=parser.parseFromString(item,'text/html');let elemSkuObj=$(elem).find('[data-price-sku]');let elemPriceObj=$(elem).find('[data-price-amount]');let elemSku=null;let elemPrice=null;if(elemSkuObj.length&&elemPriceObj.length){elemSku=elemSkuObj.attr('data-price-sku');elemPrice=elemPriceObj.attr('data-price-amount');}
deferredGa[elemSku]=elemPrice;}}
return function(parent){return parent.extend({push(layer){const _super=this._super.bind(this);if(layer.ecommerce&&customerData.get('customer')().isLoggedIn){const havePrices=this.checkPrices(layer.ecommerce.items);if(havePrices)return _super(layer);layer=JSON.parse(JSON.stringify(layer));let product=[...layer.ecommerce.items];ajax.then(()=>{product.forEach((val,key)=>{val.price=+deferredGa[val.item_id];})
layer.ecommerce.items=product;_super(layer);})}else{_super(layer);}},checkPrices:function(products){return!products.find(({price})=>!price);}});};});