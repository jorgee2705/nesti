define(["jquery","mwNavigation","mwHeader","mwrelated","mwPopup","mwqtySelector","minicart","accountSidebarSticky"],function($,mwNavigation,mwHeader,mwrelated,mwPopup,mwqtySelector,minicart,accountSidebarSticky){"strict";$(function(){mediaCheck({media:'(max-width: 991px)',entry:function(){mwNavigation.mobileNavigation();},exit:function(){mwNavigation.desktopNavigation();}});mwNavigation.desktopNavigationSubmenu();mwHeader.stickyHeader();mwHeader.toggleSearch();mwrelated.relatedSlider();minicart.showMinicart();mwqtySelector.init();if($('.account-sidebar').length){accountSidebarSticky.init();}
if($('body').hasClass('catalog-product-view')){mwPopup.openPopupLogin();}});console.log('main.js loaded');return;});