define(['jquery','uiComponent'],function($,Component){"use strict";const ga4Products=new WeakMap();const ga4Wrappers=[];return Component.extend({initialize({products,isAjax},wrap=document){this._super();const items=Object.values(JSON.parse(products));if(wrap!==document){ga4Wrappers.push(wrap);}
this.setGa4Products(wrap,items);if(isAjax){$(document).trigger('ga4Products',wrap);}},setGa4Products(wrap,items){ga4Products.set(wrap,[...this.getGa4Products(wrap),...items]);},getGa4Products(el,href){const wrap=ga4Wrappers.find(ga4Wrap=>ga4Wrap.contains(el))||document;return(ga4Products.get(wrap)||[]).filter(({item_url})=>item_url===href);}});});