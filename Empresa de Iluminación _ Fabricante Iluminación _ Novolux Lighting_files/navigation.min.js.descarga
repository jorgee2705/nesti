define(["jquery","mmenu","matchMedia","mage/menu"],function($){"strict";return{desktopNavigation:function(){var menuItems=$('.navigation .navigation__list > .level0'),navigation=$('.navigation');mediaCheck({media:'(min-width: 992px)',entry:function(){navigation.mouseleave(function(){menuItems.each(function(){$(this).removeClass('click-active');});});menuItems.each(function(){var item=$(this),link=item.find('> a');link.click(function(){openMenu();});function openMenu(){if(item.find('> .submenu').length){event.preventDefault();if(item.hasClass('click-active')){item.removeClass('click-active');}
else{menuItems.each(function(){$(this).removeClass('click-active');});item.addClass('click-active');}}
else{menuItems.each(function(){$(this).removeClass('click-active');});}}});$('html').removeClass('mm-wrapper_opened mm-wrapper_opening');$('.custom-navigation').removeClass('mm-menu_opened');},exit:function(){if($('html').hasClass('mm-wrapper_blocking')){$('html').addClass('mm-wrapper_opened mm-wrapper_opening');$('.custom-navigation').addClass('mm-menu_opened');}}});},desktopNavigationSubmenu:function(){var menuItems=$('.navigation .navigation__list .submenu .submenu-items > .level1'),navigation=$('.navigation');mediaCheck({media:'(min-width: 992px)',entry:function(){navigation.mouseleave(function(){menuItems.each(function(){$(this).removeClass('click-active');});});menuItems.each(function(){var item=$(this),link=item.find('> a');link.mouseover(function(){openMenu();});function openMenu(){if(item.find('> .submenu').length){event.preventDefault();if(item.hasClass('click-active')){item.removeClass('click-active');}
else{menuItems.each(function(){$(this).removeClass('click-active');});item.addClass('click-active');}}
else{menuItems.each(function(){$(this).removeClass('click-active');});}}});},exit:function(){}});},mobileNavigation:function(){var navigation=$('.navigation'),toggle=$('.action.nav-toggle'),customerLink=$('.navigation.links-customer').clone(),navSecondary="<div class='navigation--secondary'><ul class='navigation__links'>"+customerLink.html()+"</ul></div>",customNav=$('.navigation.custom-navigation li.nav-1.category-item').clone(),customNavBlock=$("<div class='custom-nav'><ul><li class='parent-custom'>"+customNav.html()+"</li></ul></div> ");if($('.custom-navigation').length>1){return;}
var menu=navigation.mmenu({},{clone:true});var API=menu.data("mmenu");var navigationList=$('.mm-menu .mm-panels > .mm-panel:first-of-type > .mm-listview:first-of-type');if($(customerLink).length){navigationList.append(navSecondary);}
if($(customNav).length){customNavBlock.insertAfter(navigationList);$('.custom-nav .parent-custom a.level-top').on('click',function(){$('.parent-custom').toggleClass('click-active');})}
toggle.click(function(){moveSticky();API.open();});function moveSticky(){if($('.page-header').hasClass('sticky')){var calculateTop=$('.page-header.sticky').offset().top-$('body').offset().top;API.bind("open:start",function(){$('.page-header.sticky').css('top',calculateTop);});API.bind("close:start",function(){$('.page-header.sticky').css('top','0');});}}}};});