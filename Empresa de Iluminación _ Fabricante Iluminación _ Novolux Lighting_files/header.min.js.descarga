define(["jquery","mmenu","matchMedia","mage/menu"],function($){"strict";return{stickyHeader:function(){const header=$('.page-header'),content=$('.page-wrapper'),pos=header.height(),win=$(document),headerHeight=header.height();if(win.scrollTop()>=pos){if(!header.hasClass("sticky")){header.addClass("sticky");content.css('margin-top',headerHeight+25);}}
win.on("scroll",function(){if(win.scrollTop()>=pos){if(!header.hasClass("sticky")){header.addClass("sticky");content.css('margin-top',headerHeight+25);}}else{if(header.hasClass("sticky")&&!header.hasClass("hide")){header.removeClass("sticky");content.css('margin-top',0);}}});},toggleSearch:function(){$('.minisearch__trigger').click(function(o){o.preventDefault();if(!$('.minisearch__content').hasClass('active')){$('.minisearch__content').addClass('active');$('body').addClass('noscroll');}else{$('.minisearch__content').removeClass('active');$('body').removeClass('noscroll');}
$('#search').focus();});$('.minisearch__close').click(function(){if(!$('.minisearch__content').hasClass('active')){$('.minisearch__content').addClass('active');$('body').addClass('noscroll');}else{$('.minisearch__content').removeClass('active');$('body').removeClass('noscroll');}});},};});