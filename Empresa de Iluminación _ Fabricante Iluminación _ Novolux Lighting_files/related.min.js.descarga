define(["jquery","slick"],function($){"strict";return{relatedSlider:function(){var list=$('.module-related--slider .product-items');var slidesToShow=4;list.each(function(){if(!$(this).hasClass('slick-initialized')){mediaCheck({media:'(max-width: 991px)',entry:function(){slidesToShow=3;},exit:function(){}});mediaCheck({media:'(max-width: 767px)',entry:function(){slidesToShow=3;},exit:function(){}});mediaCheck({media:'(max-width: 575px)',entry:function(){slidesToShow=1;},exit:function(){}});var items=$(this).find('li.product-item').length;if(items>slidesToShow){$(this).slick({infinite:true,slidesToShow:slidesToShow,slidesToScroll:1,arrows:true});}}});}}});