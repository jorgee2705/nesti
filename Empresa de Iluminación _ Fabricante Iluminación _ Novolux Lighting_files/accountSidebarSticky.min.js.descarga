define(["jquery","matchMedia"],function($){"strict";return{init:function(){mediaCheck({media:'(min-width: 992px)',entry:function(){$(window).scroll(function(){if($(window).scrollTop()>83){$('.account-sidebar .sidebar__main').css('position','fixed');$('.account-sidebar .sidebar__main').css('top','0');$('body').addClass('sidebar-sticky');}
else if($(window).scrollTop()<=83){$('.account-sidebar .sidebar__main').css('position','');$('.account-sidebar .sidebar__main').css('top','');$('body').removeClass('sidebar-sticky');}
if($('.account-sidebar .sidebar__main').offset().top+$(".account-sidebar .sidebar__main").height()>$(".page-footer.footer").offset().top){$('.account-sidebar .sidebar__main').css('top',-($(".account-sidebar .sidebar__main").offset().top+$(".account-sidebar .sidebar__main").height()-$(".page-footer.footer").offset().top));}});},exit:function(){}});}};});